# Formspree form ID for the Contact form (https://formspree.io).
# Sign up at formspree.io -> create a new form -> copy the ID from the
# endpoint URL shown there: https://formspree.io/f/{FORM_ID}
# Leave this unset/blank to run without a live form — Contact.jsx falls
# back to a plain mailto: link and simply doesn't render the <form> at all.
VITE_FORMSPREE_FORM_ID=
